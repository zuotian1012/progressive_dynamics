+UIPC_GENERIC Vector3 shell_offset(const Vector3& a, const Vector3& b, const Vector3& c,
+                                 const ShellOffset& offset)
+{
+    if(offset.local.squaredNorm() == 0)
+        return Vector3::Zero();
+    const Vector3 e = b - a;
+    const Vector3 f = c - a;
+    const Vector3 cross = e.cross(f);
